# Neon.tech PostgreSQL
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/hermes?sslmode=require"

# Auth.js v5 (next-auth)
AUTH_SECRET="generate-with-pnpm dlx auth secret"
AUTH_URL="http://localhost:3000"

# Public site URL (used for metadata, sitemap, robots, JSON-LD).
# In production set this to your real domain, e.g. https://hermes.example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Factus (facturación electrónica DIAN): la URL de la API y la cuenta de pruebas ya no van aquí.
# El administrador de plataforma (GOD) las configura en Configuración del Sistema → Factus de la
# plataforma, y cada empresa guarda sus credenciales cifradas en Configuración → Facturación electrónica.

# Llave para cifrar las credenciales de Factus (32 bytes en base64): openssl rand -base64 32
ENCRYPTION_KEY=""

# Secreto del cron que llama a /api/invoicing/retry (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
